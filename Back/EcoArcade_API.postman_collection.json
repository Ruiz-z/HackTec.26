{
  "info": {
    "name": "EcoArcade API",
    "description": "Colección para probar todos los endpoints del backend EcoArcade.\n\n## Setup\n1. Importar en Postman\n2. Verificar que `base_url` apunte a donde corra el backend\n3. Ejecutar **Auth → Login** primero (auto-guarda el token)\n\n## Flujo recomendado\nLogin → Me → QR Scan → Ranking → Deposit (ok) → Deposit (mismatch) → Dashboard → Admin panel",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "ecoarcade"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3001/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "userId", "value": "1", "type": "string" },
    { "key": "botId", "value": "B3", "type": "string" },
    { "key": "basureroId", "value": "3", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Autenticación JWT. Login devuelve token + user + rol + permisos.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('Token guardado:', json.token.substring(0, 20) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": null,
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mauro@eco.com\",\n  \"password\": \"demo123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Scan & Deposit",
      "description": "Escaneo QR de basurero y depósito de residuos.",
      "item": [
        {
          "name": "QR Scan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/scan?botId={{botId}}",
              "host": ["{{base_url}}"],
              "path": ["scan"],
              "query": [
                { "key": "botId", "value": "{{botId}}" }
              ]
            }
          }
        },
        {
          "name": "Deposit — OK",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image\": \"\",\n  \"botId\": \"{{botId}}\",\n  \"offlineKeyword\": \"botella de plastico\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/bins/deposit",
              "host": ["{{base_url}}"],
              "path": ["bins", "deposit"]
            }
          }
        },
        {
          "name": "Deposit — TYPE_MISMATCH",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image\": \"\",\n  \"botId\": \"{{botId}}\",\n  \"offlineKeyword\": \"botella de vidrio\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/bins/deposit",
              "host": ["{{base_url}}"],
              "path": ["bins", "deposit"]
            }
          }
        }
      ]
    },
    {
      "name": "Classify",
      "description": "Clasificación de residuos por IA (Claude Vision) con fallback offline.",
      "item": [
        {
          "name": "Classify",
          "request": {
            "auth": null,
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offlineKeyword\": \"lata de aluminio\",\n  \"userId\": {{userId}},\n  \"basureroId\": {{basureroId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/classify",
              "host": ["{{base_url}}"],
              "path": ["classify"]
            }
          }
        },
        {
          "name": "Recientes",
          "request": {
            "auth": null,
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/classify/recientes",
              "host": ["{{base_url}}"],
              "path": ["classify", "recientes"]
            }
          }
        }
      ]
    },
