              "raw": "{\n  \"rfid\": \"TEST999\",\n  \"nombre\": \"Test Postman\",\n  \"email\": \"test@postman.com\",\n  \"password\": \"test123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          }
        }
      ]
    },
    {
